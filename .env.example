# Создайте .env из этого файла. Токен не отправляйте в группу.
TELEGRAM_BOT_TOKEN=
# Telegram user ID администраторов через запятую.
ADMIN_IDS=
# Если VPN работает как локальный прокси, укажите его URL (HTTP или SOCKS5).
# PROXY_URL направляет через него все источники; TELEGRAM_PROXY_URL — только Telegram.
PROXY_URL=
TELEGRAM_PROXY_URL=
TELEGRAM_REQUEST_TIMEOUT_SECONDS=20
# Старую одиночную привязку бот переносит в список мест при первом запуске.
# Группы и каналы добавляются в админке «Куда публиковать».
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=
DATA_DIR=data
MODEL_PATH=data/model.json
# Необязательная модель для сравнения на будущих картах; её прогнозы не публикуются.
SHADOW_MODEL_PATH=
# Бот сначала показывает карточки администратору. Автопубликация включается в /admin.
AUTO_PUBLISH=false
POLL_SECONDS=45
MAX_DRAFT_AGE_SECONDS=180
MAX_GAME_TIME_SECONDS=90
MIN_FAVORITE_PROBABILITY=0.55
# Разбирать все полные драфты выбранных турниров; слабый сигнал отмечается в карточке.
PUBLISH_ALL_MAPS=true
# Запоздавшие разборы публикуются с отметкой и считаются отдельно.
ALLOW_DELAYED_ANALYSIS=true
# Утреннее расписание выбранных турниров; время московское.
MORNING_BRIEF_ENABLED=true
MORNING_BRIEF_HOUR=10
QUOTE_MAX_AGE_SECONDS=30
# Окно приоритета Polymarket перед использованием сохранённого Fonbet.
# 0 разрешает сразу использовать подходящий кэф доступного источника.
QUOTE_WAIT_SECONDS=120
# Без исходного кэфа прогноз и личные уведомления остаются в ожидании.
REQUIRE_INITIAL_ODDS=true
# Сообщать о росте кэфа Polymarket на фаворита ответом на исходный прогноз.
ODDS_ALERTS_ENABLED=true
ODDS_ALERT_RELATIVE_INCREASE=0.20
ODDS_ALERT_MIN_INCREASE=0.20
ODDS_ALERT_COOLDOWN_SECONDS=600
ODDS_ALERT_MAX_PER_MAP=3
OPENDOTA_API_KEY=
# Steam Web API: дополнительный источник драфтов, номера карт и результаты.
STEAM_API_KEY=
# Необязательный поставщик котировок нескольких букмекеров.
ODDSPAPI_API_KEY=
ODDSPAPI_BASE_URL=https://api.oddspapi.io/v4
# Other provider: coverage diagnostics only; Dota 2 is not in its verified catalogue.
THE_ODDS_API_KEY=
# Fonbet snapshots before the series; Polymarket remains the in-play tracker.
ODDSPAPI_DAILY_REQUEST_LIMIT=8
ODDSPAPI_PREFETCH_SECONDS=86400
# Дополнительный источник JSON-котировок по контракту docs/odds-feed.md.
ODDS_FEED_URL=
ODDS_FEED_API_KEY=
